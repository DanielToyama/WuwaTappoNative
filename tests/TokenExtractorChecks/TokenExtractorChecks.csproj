<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WuwatappoNative.TokenExtractorChecks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接编译被测源码，避免测试依赖 WinForms 窗口或启动提取器。 -->
    <Compile Include="../../token-extractor/NativeTokenReader.cs" Link="NativeTokenReader.cs" />
    <Compile Include="../../token-extractor/TokenSafety.cs" Link="TokenSafety.cs" />
    <Compile Include="../../src/Net/OfficialTokenReader.cs" Link="OfficialTokenReader.cs" />
  </ItemGroup>
</Project>
